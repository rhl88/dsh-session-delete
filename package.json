{
  "name": "@local/dsh-session-delete",
  "version": "1.0.0",
  "type": "module",
  "description": "Permanently delete DSH sessions from the sidebar session menu, beyond archive-only session management.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "index.js",
    "paths.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "INSTALL.zh.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "session",
    "delete",
    "purge"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhl88/dsh-session-delete.git"
  },
  "homepage": "https://github.com/rhl88/dsh-session-delete#readme",
  "bugs": {
    "url": "https://github.com/rhl88/dsh-session-delete/issues"
  },
  "author": "holley",
  "license": "MIT"
}
